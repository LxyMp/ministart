    "%@ was kept: its credentials could not be removed from your login Keychain.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保留 %@：无法从你的登录钥匙串中移除其凭证。"

    "Context %@, %lld of %lld messages sent": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Context %1$@, %2$lld of %3$#@n@ sent"
          },
          "substitutions": {
            "n": {
              "argNum": 3,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%lld message"
                    }
                  },

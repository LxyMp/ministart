{
  "sourceLanguage": "en",
  "strings": {
    "": {},
    "%@ %@ is available": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ is available"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ 可用"
          }
        }
      }
    },
    "%@ (%lld items)": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@ (%lld item)"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@ (%lld items)"
                }
              }
            }
          }
        },
        "zh-Hans": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@（%lld 个项目）"
                }
              }
            }
          }
        }
      }
    },
    "%@ (optional)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（可选）"
          }
        }
      }
    },
    "%@ Copy": {
      "comment": "Default name for a duplicated window layout",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 拷贝"
          }
        }
      }
    },
    "%@ already exists. Import applies its settings here; Replace overwrites it with the current ones.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”已存在。“导入”会将其设置应用到此处；“替换”会用当前设置覆盖它。"
          }
        }
      }
    },
    "%@ and %lld more": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@ and %lld more"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@ and %lld more"
                }
              }
            }
          }
        },
        "zh-Hans": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@ 及另外 %lld 项"
                }
              }
            }
          }
        }
      }
    },
    "%@ and %lld more will use the %@ keys instead of the ones you set.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@ and %lld more will use the %@ keys instead of the ones you set."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@ and %lld more will use the %@ keys instead of the ones you set."
                }
              }
            }
          }
        },
        "zh-Hans": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@ 及另外 %lld 项将使用 %@ 按键，而不是你设置的按键。"
                }
              }
            }
          }
        }
      }
    },
    "%@ applied": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已应用 %@"
          }
        }
      }
    },
    "%@ at %@": {
      "comment": "A date followed by a clock time, e.g. “Monday, 5 January at 9:00”",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ at %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@"
          }
        }
      }
    },
    "%@ can't have a shortcut": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不能设置快捷键"
          }
        }
      }
    },
    "%@ could not finish the response.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 无法完成回复。"
          }
        }
      }
    },
    "%@ could not start: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ could not start: %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 无法启动：%@"
          }
        }
      }
    },
    "%@ couldn't replace the selection — copied instead": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 无法替换所选内容，已改为拷贝"
          }
        }
      }
    },
    "%@ didn’t quit. Quit it, then try again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 未退出。请先退出它，然后重试。"
          }
        }
      }
    },
    "%@ doesn't share its text with Ministart.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不会与 Ministart 共享其文本。"
          }
        }
      }
    },
    "%@ doesn't update itself": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不会自动更新"
          }
        }
      }
    },
    "%@ exited with status %d.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ exited with status %2$d."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已退出，状态码 %d。"
          }
        }
      }
    },
    "%@ has no built bundle — reinstall the extension.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 没有已构建的包，请重新安装该扩展。"
          }
        }
      }
    },
    "%@ has no menu bar to search": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 没有可搜索的菜单栏"
          }
        }
      }
    },
    "%@ hasn't been downloaded yet.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 尚未下载。"
          }
        }
      }
    },
    "%@ installs": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 次安装"
          }
        }
      }
    },
    "%@ is disabled in AI Settings.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已在 AI 设置中停用。"
          }
        }
      }
    },
    "%@ is no longer running.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已不再运行。"
          }
        }
      }
    },
    "%@ is too large to download.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 太大，无法下载。"
          }
        }
      }
    },
    "%@ is up to date": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已是最新版本"
          }
        }
      }
    },
    "%@ isn't installed on this Mac.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Mac 上未安装 %@。"
          }
        }
      }
    },
    "%@ isn’t installed any more.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已不再安装。"
          }
        }
      }
    },
    "%@ items so far. Results appear when it finishes.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前已有 %@ 个项目。完成后将显示结果。"
          }
        }
      }
    },
    "%@ items · Built %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ items · Built %2$@"
          }

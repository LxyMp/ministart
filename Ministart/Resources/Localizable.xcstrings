    "This backup contains %lld custom commands and %lld global shortcuts. Custom commands can run arbitrary shell code. Only import files you trust.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This backup contains %1$#@c@ and %2$#@s@. Custom commands can run arbitrary shell code. Only import files you trust."
          },
          "substitutions": {
            "c": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%lld custom command"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%lld custom commands"
                    }
                  }
                }
              }
            },
            "s": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%lld global shortcut"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%lld global shortcuts"
                    }
                  }
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此备份包含 %1$#@c@和 %2$#@s@。自定义命令可以运行任意 shell 代码。请仅导入你信任的文件。"
          },
          "substitutions": {
            "c": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%lld 个自定义命令"
                    }
                  }
                }
              }
            },
            "s": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%lld 个全局快捷键"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },

{
  "sourceLanguage": "en",
  "strings": {
    "": {},
    "%@ (optional)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（可选）"
          }
        }
      }
    },
    "%@ already exists. Import applies its settings here; Replace overwrites it with the current ones.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”已存在。“导入”会将其设置应用到此处；“替换”会用当前设置覆盖它。"
          }
        }
      }
    },
    "%@ and %lld more": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@ and %lld more"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@ and %lld more"
                }
              }
            }
          }
        },
        "zh-Hans": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%@ 及另外 %lld 项"
                }
              }
            }
          }
        }
      }
    },
    "%@ at %@": {
      "comment": "A date followed by a clock time, e.g. “Monday, 5 January at 9:00”",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ at %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@"
          }
        }
      }
    },
    "%@ can't have a shortcut": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不能设置快捷键"
          }
        }
      }
    },
    "%@ didn’t quit. Quit it, then try again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 未退出。请先退出它，然后重试。"
          }
        }
      }
    },
    "%@ doesn't contain a Raycast extension (no package.json with commands).": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不包含 Raycast 扩展（没有带 commands 的 package.json）。"
          }
        }
      }
    },
    "%@ doesn't contain a Raycast extension manifest.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不包含 Raycast 扩展清单。"
          }
        }
      }
    },
    "%@ doesn't support macOS.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不支持 macOS。"
          }
        }
      }
    },
    "%@ has no built bundle — reinstall the extension.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 没有已构建的包，请重新安装该扩展。"
          }
        }
      }
    },
    "%@ has no built command bundles. Ministart installs prebuilt extensions — run `ray build` in the extension folder first, or import one from an installed Raycast.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 没有已构建的命令包。Ministart 安装的是预构建扩展——请先在扩展目录运行 `ray build`，或从已安装的 Raycast 导入。"
          }
        }
      }
    },
    "%@ installs": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 次安装"
          }
        }
      }
    },
    "%@ is too large to download.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 太大，无法下载。"
          }
        }
      }
    },
    "%@ isn't installed on this Mac.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Mac 上未安装 %@。"
          }
        }

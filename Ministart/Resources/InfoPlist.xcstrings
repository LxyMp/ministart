{
  "sourceLanguage": "en",
  "strings": {
    "NSAppleEventsUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ministart uses automation to perform system actions you explicitly run."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Ministart 使用自动化来执行你主动运行的系统操作。"
          }
        }
      }
    },
    "NSBluetoothAlwaysUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ministart uses Bluetooth access only when you run the Toggle Bluetooth action."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Ministart 仅在你运行切换蓝牙操作时访问蓝牙。"
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ministart accesses your events to show your schedule and let you join meetings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Ministart 访问你的日程，以显示安排并让你加入会议。"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ministart shows a camera preview so you can check yourself, and take a photo to the clipboard."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Ministart 显示相机预览，方便你查看自己的形象，并将拍摄的照片拷贝到剪贴板。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ministart records audio only while you use Dictation, to transcribe it on your Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Ministart 仅在你使用听写时录制音频，并在你的 Mac 上将其转为文字。"
          }
        }
      }
    },
    "NSRemindersFullAccessUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ministart lets extensions you run read and edit your reminders."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Ministart 允许你运行的扩展读取和编辑你的提醒事项。"
          }
        }
      }
    },
    "Ministart Backup": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ministart Backup"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Ministart 备份"
          }
        }
      }
    }
  },
  "version": "1.0"
}
